{"nodes": [{"id": "_claude_skills_backend_architecture_skill_backend_architecture_skill", "label": "Backend Architecture Skill", "file_type": "document", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L1-L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_backend_architecture_skill_layered_architecture", "label": "Layered Backend Architecture (endpoints/services/repositories)", "file_type": "rationale", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L16-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endpoints stay thin, services own the transaction and raise app errors (never HTTPException), repositories flush but never commit; keeps access control in api/deps.py and data access tenant-scoped."}, {"id": "_claude_skills_backend_architecture_skill_tenantscopedrepository", "label": "TenantScopedRepository", "file_type": "concept", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds WHERE tenant_id = ? to every query; plain select() on tenant data outside it is how cross-tenant leaks happen."}, {"id": "_claude_skills_backend_architecture_skill_tenantscopedmixin", "label": "TenantScopedMixin", "file_type": "concept", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_backend_architecture_skill_per_tenant_accounts", "label": "Per-Tenant Accounts (users.tenant_id + tenant_role)", "file_type": "concept", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L33-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_backend_architecture_skill_jwt_identity_only", "label": "JWT Carries Identity Only", "file_type": "rationale", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L36-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roles and tenant are read from the DB each request so removing a user or changing a role takes effect immediately."}, {"id": "_claude_skills_backend_architecture_skill_x_tenant_slug_header", "label": "X-Tenant-Slug Header Tenant Resolution", "file_type": "concept", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L38-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "get_tenant_context returns the same 403 for unknown slug or another tenant so slugs cannot be probed."}, {"id": "_claude_skills_backend_architecture_skill_invite_only_onboarding", "label": "Invite-Only Onboarding", "file_type": "concept", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L42-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No self-registration or public tenant list; one-time sha256-hashed invite token (72h) redeemed at /auth/accept-invite."}, {"id": "_claude_skills_backend_architecture_skill_role_permission_matrix", "label": "Five Roles Permission Matrix", "file_type": "concept", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L50-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "superadmin/admin/superviewer see tenant metadata only, never tenant users (PII) or courses; tenantadmin/user operate on tenant data."}, {"id": "_claude_skills_backend_architecture_skill_permission_dependencies", "label": "Permission Dependencies (TenantMember, TenantManager, TenantInviter, ...)", "file_type": "concept", "source_file": ".claude/skills/backend-architecture/SKILL.md", "source_location": "L67-L76", "s